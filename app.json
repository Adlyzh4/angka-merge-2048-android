{
  "expo": {
    "name": "angka-merge-2048",
    "slug": "angka-merge-2048",
    "scheme": "angkamerge2048",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.metaunitasdev.angkamerge2048"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1868043610140076~9586296654",
          "iosAppId": "ca-app-pub-1868043610140076~9586296654"
        }
      ],
      "expo-build-properties",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6b37b845-b055-44ee-b553-0fa44c8e260a"
      }
    }
  }
}
